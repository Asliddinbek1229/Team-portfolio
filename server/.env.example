# server/.env ga nusxalang:  cp server/.env.example server/.env
# va qiymatlarni o'zgartiring. Bu fayl gitga tushmaydi.

# Admin panel paroli — kamida 16 belgi, tasodifiy
ADMIN_PASSWORD=bu-yerga-kuchli-parol
# Token imzosi uchun uzun tasodifiy satr:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=bu-yerga-64-belgili-tasodifiy-satr

# Server porti va manzili. Domen yo'q paytda sayt http://SERVER_IP:API_PORT da ochiladi.
API_PORT=8080
HOST=0.0.0.0
